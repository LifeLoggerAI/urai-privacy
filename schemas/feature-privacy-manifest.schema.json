{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uraiprivacy.com/schemas/feature-privacy-manifest.schema.json",
  "title": "URAI Privacy Feature Manifest",
  "type": "object",
  "required": [
    "feature",
    "repo",
    "owner",
    "privacyGovernanceVersion",
    "status",
    "lastReviewed",
    "dataProcessing",
    "userRights",
    "adminAccess",
    "monetization",
    "review"
  ],
  "additionalProperties": false,
  "properties": {
    "feature": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "privacyGovernanceVersion": {"const": "0.1.0-draft"},
    "status": {"enum": ["draft", "review", "approved", "blocked"]},
    "lastReviewed": {"type": "string"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {"type": "string"},
        "userBenefit": {"type": "string"},
        "releaseTarget": {"type": "string"}
      }
    },
    "dataProcessing": {
      "type": "object",
      "required": ["collectedFields", "derivedFields"],
      "additionalProperties": false,
      "properties": {
        "collectedFields": {
          "type": "array",
          "items": {"$ref": "#/$defs/collectedField"}
        },
        "derivedFields": {
          "type": "array",
          "items": {"$ref": "#/$defs/derivedField"}
        }
      }
    },
    "userRights": {
      "type": "object",
      "required": ["exportSupported", "deletionSupported", "consentRevocationSupported", "explanationSupported"],
      "additionalProperties": false,
      "properties": {
        "exportSupported": {"type": "boolean"},
        "deletionSupported": {"type": "boolean"},
        "consentRevocationSupported": {"type": "boolean"},
        "explanationSupported": {"type": "boolean"}
      }
    },
    "adminAccess": {
      "type": "object",
      "required": ["allowed", "roles", "auditEventTypes"],
      "additionalProperties": false,
      "properties": {
        "allowed": {"type": "boolean"},
        "roles": {"type": "array", "items": {"type": "string"}},
        "auditEventTypes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "monetization": {
      "type": "object",
      "required": ["participatesInDataSharing", "requiresC8Consent", "anonymizationBatchRequired", "minimumCohortSize"],
      "additionalProperties": false,
      "properties": {
        "participatesInDataSharing": {"type": "boolean"},
        "requiresC8Consent": {"type": "boolean"},
        "anonymizationBatchRequired": {"type": "boolean"},
        "minimumCohortSize": {"type": "integer", "minimum": 0}
      }
    },
    "review": {
      "type": "object",
      "required": ["reviewer", "decision", "notes"],
      "additionalProperties": false,
      "properties": {
        "reviewer": {"type": "string"},
        "decision": {"enum": ["approved", "approved_with_conditions", "blocked", "pending"]},
        "notes": {"type": "string"}
      }
    }
  },
  "$defs": {
    "dataClass": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7"]},
    "consentTier": {"enum": ["C0", "C1", "C2", "C3", "C4", "C5", "C6", "C7", "C8"]},
    "retentionClass": {"enum": ["R0", "R1", "R2", "R3", "R4", "R5", "R6"]},
    "source": {"enum": ["user", "device", "system", "model", "admin", "partner"]},
    "collectedField": {
      "type": "object",
      "required": ["name", "dataClass", "source", "purpose", "consentTier", "retentionClass", "exportable", "deletable", "auditRequired"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dataClass": {"$ref": "#/$defs/dataClass"},
        "source": {"$ref": "#/$defs/source"},
        "purpose": {"type": "string", "minLength": 1},
        "consentTier": {"$ref": "#/$defs/consentTier"},
        "retentionClass": {"$ref": "#/$defs/retentionClass"},
        "exportable": {"type": "boolean"},
        "deletable": {"type": "boolean"},
        "auditRequired": {"type": "boolean"}
      }
    },
    "derivedField": {
      "type": "object",
      "required": ["name", "dataClass", "sourceFields", "purpose", "consentTier", "retentionClass", "explainabilityRequired"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dataClass": {"$ref": "#/$defs/dataClass"},
        "sourceFields": {"type": "array", "items": {"type": "string"}},
        "purpose": {"type": "string", "minLength": 1},
        "consentTier": {"$ref": "#/$defs/consentTier"},
        "retentionClass": {"$ref": "#/$defs/retentionClass"},
        "explainabilityRequired": {"type": "boolean"}
      }
    }
  }
}
