{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "URAI Privacy Firestore Schema Contract",
  "version": "0.1.0-draft",
  "description": "Canonical privacy, consent, data governance, export, deletion, monetization, and incident records for URAI services.",
  "type": "object",
  "required": [
    "userConsent",
    "consentEvents",
    "privacyRequests",
    "deletionJobs",
    "exportJobs",
    "dataAccessLogs",
    "dataProcessingRecords",
    "anonymizationBatches",
    "monetizationLedger",
    "incidentReports"
  ],
  "properties": {
    "userConsent": {
      "description": "Current consent state per user and consent tier.",
      "type": "object",
      "required": ["userId", "policyVersion", "tiers", "updatedAt"],
      "properties": {
        "userId": {"type": "string"},
        "policyVersion": {"type": "string"},
        "jurisdiction": {"type": "string"},
        "tiers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["status", "updatedAt"],
            "properties": {
              "status": {"enum": ["granted", "denied", "revoked", "expired"]},
              "surface": {"type": "string"},
              "evidenceHash": {"type": "string"},
              "updatedAt": {"type": "string", "format": "date-time"}
            }
          }
        },
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "consentEvents": {
      "description": "Append-only consent event log.",
      "type": "object",
      "required": ["eventId", "userId", "consentTier", "status", "policyVersion", "timestamp"],
      "properties": {
        "eventId": {"type": "string"},
        "userId": {"type": "string"},
        "consentTier": {"type": "string"},
        "status": {"enum": ["granted", "denied", "revoked", "expired"]},
        "surface": {"type": "string"},
        "policyVersion": {"type": "string"},
        "jurisdiction": {"type": "string"},
        "evidenceHash": {"type": "string"},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "privacyRequests": {
      "description": "User rights requests for export, deletion, correction, opt-out, or review.",
      "type": "object",
      "required": ["requestId", "userId", "type", "status", "createdAt"],
      "properties": {
        "requestId": {"type": "string"},
        "userId": {"type": "string"},
        "type": {"enum": ["export", "delete", "correct", "restrict", "monetization_opt_out", "human_review"]},
        "status": {"enum": ["received", "validated", "queued", "processing", "completed", "failed", "cancelled"]},
        "scope": {"type": "object"},
        "createdAt": {"type": "string", "format": "date-time"},
        "completedAt": {"type": ["string", "null"], "format": "date-time"},
        "failureReason": {"type": ["string", "null"]}
      }
    },
    "deletionJobs": {
      "description": "Execution records for deletion requests.",
      "type": "object",
      "required": ["jobId", "requestId", "userId", "stage", "createdAt"],
      "properties": {
        "jobId": {"type": "string"},
        "requestId": {"type": "string"},
        "userId": {"type": "string"},
        "stage": {"enum": ["requested", "validated", "queued", "primary_store_deleted", "derived_records_deleted_or_recomputed", "backup_expiry_scheduled", "completed", "failed_with_reason"]},
        "dataClasses": {"type": "array", "items": {"type": "string"}},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "exportJobs": {
      "description": "Execution records for data export requests.",
      "type": "object",
      "required": ["exportId", "requestId", "userId", "status", "createdAt"],
      "properties": {
        "exportId": {"type": "string"},
        "requestId": {"type": "string"},
        "userId": {"type": "string"},
        "status": {"enum": ["queued", "processing", "ready", "downloaded", "expired", "failed"]},
        "format": {"enum": ["json", "csv", "markdown", "html", "zip"]},
        "manifestHash": {"type": "string"},
        "downloadUrlExpiresAt": {"type": ["string", "null"], "format": "date-time"},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "dataAccessLogs": {
      "description": "Append-only audit logs for privacy-relevant access.",
      "type": "object",
      "required": ["eventId", "eventType", "actorType", "actorId", "timestamp", "outcome"],
      "properties": {
        "eventId": {"type": "string"},
        "eventType": {"type": "string"},
        "actorType": {"enum": ["user", "admin", "system", "service", "partner"]},
        "actorId": {"type": "string"},
        "targetUserId": {"type": ["string", "null"]},
        "dataClasses": {"type": "array", "items": {"type": "string"}},
        "purpose": {"type": "string"},
        "policyVersion": {"type": "string"},
        "sourceRepo": {"type": "string"},
        "sourceService": {"type": "string"},
        "requestId": {"type": "string"},
        "outcome": {"enum": ["allowed", "denied", "failed", "completed"]},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "dataProcessingRecords": {"type": "object"},
    "anonymizationBatches": {"type": "object"},
    "monetizationLedger": {"type": "object"},
    "incidentReports": {"type": "object"}
  }
}
