rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin')
      );
    }
    function isCreateOrUpdate() { return request.resource != null; }

    function exportJob(jobId) {
      return firestore.get(/databases/(default)/documents/exportJobs/$(jobId));
    }
    // Export reads and admin export writes must respect the same strict deletion
    // fence as Firestore profiles and server-side Life Movie processing.
    // An in-flight deletion-planning lease is NOT an inactive account.
    function deletionFenceIsInactive(uid) {
      let tombstone = /databases/(default)/documents/privacyDeletionTombstones/$(uid);
      return !firestore.exists(tombstone) || (
        firestore.get(tombstone).data.get('active', null) == false
        && !firestore.get(tombstone).data.keys().hasAny([
          'deletionPlanningLeaseToken',
          'deletionPlanningLeaseUntil',
          'deletionPlanningLeaseRequestId',
          'deletionPlanningLeaseOperation',
          'deletionPlanningLeaseBy'
        ])
      );
    }
    function activeExportPackage(uid, jobId) {
      return deletionFenceIsInactive(uid)
        && firestore.exists(/databases/(default)/documents/exportJobs/$(jobId))
        && exportJob(jobId).data.uid == uid
        && exportJob(jobId).data.status == "completed"
        && exportJob(jobId).data.complete == true
        && exportJob(jobId).data.packageExpiresAt is timestamp
        && exportJob(jobId).data.packageExpiresAt > request.time;
    }

    // Always deny direct client export delivery, even for owners and admins.
    // The authenticated Functions broker must verify current C7 consent,
    // account incarnation, revocation, deletion and exact job/source authority.
    match /exports/{uid}/{allPaths=**} {
      allow read, write: if false;
    }

    match /evidence/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isCreateOrUpdate();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
