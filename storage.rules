rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin')
      );
    }
    function isCreateOrUpdate() { return request.resource != null; }

    // Private export bytes can only be delivered by the authenticated Function,
    // which checks current authority again before each bounded stream chunk.
    // A direct Storage SDK read cannot enforce mid-transfer withdrawal.
    match /exports/{uid}/{allPaths=**} {
      allow read, write: if false;
    }

    match /evidence/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isCreateOrUpdate();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
