rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin')
      );
    }
    function isCreateOrUpdate() { return request.resource != null; }

    // The authenticated export service checks current consent and request identity.
    match /exports/{uid}/{jobId}/{fileName} {
      allow read, write: if false;
    }

    match /evidence/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isCreateOrUpdate();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
