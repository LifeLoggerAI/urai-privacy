{
  "name": "urai-privacy",
  "version": "0.2.0-staging-scaffold",
  "private": true,
  "description": "URAI Privacy standalone Firebase and Next.js privacy product scaffold.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/smoke-routes.mjs",
    "test:rules": "node scripts/validate-rules.mjs",
    "test:smoke": "node scripts/smoke-routes.mjs",
    "test:emulators": "npm run test:rules && npm run test:integration",
    "build": "next build",
    "preflight": "npm run lint && npm run typecheck && npm run test && npm run test:rules && npm run test:e2e && npm run build",
    "preflight:production": "bash scripts/verify-release.sh",
    "security:gate": "python tools/check_secrets.py",
    "deploy": "firebase deploy",
    "verify:production": "bash scripts/verify-release.sh",
    "verify:release": "bash scripts/verify-release.sh"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
