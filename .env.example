# URAI Privacy public Firebase client configuration
# Copy to .env.local for local development and set equivalent environment variables in hosting.
# Do not commit real secrets, service account JSON, private keys, cookies, or access tokens.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Admin access is authorized by Firebase Auth custom claims only.
# Required accepted claims: admin === true or role === "admin".
# Do not use public environment variables as an admin authority source.
