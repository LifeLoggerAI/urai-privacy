# URAI Privacy local/staging Firebase web configuration
# Copy to .env.local for local development. Do not commit real .env.local or service account files.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: deployment/runtime metadata used by release evidence and diagnostics.
NEXT_PUBLIC_URAI_PRIVACY_ENV=local
NEXT_PUBLIC_URAI_PRIVACY_RELEASE_COMMIT=
