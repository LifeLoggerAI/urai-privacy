{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urai.app/schemas/memoryIntegrity.schema.json",
  "title": "URAI Memory Integrity Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["memoryId", "state", "sourceProvenance", "confidence", "userControls", "audit"],
  "properties": {
    "memoryId": { "type": "string" },
    "familyIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^URAI-[0-9]{3}$" },
      "uniqueItems": true
    },
    "state": {
      "type": "string",
      "enum": ["canonical", "inferred", "lowConfidence", "disputed", "quarantined", "deleted", "archived", "excludedFromModel", "requiresReview"]
    },
    "sourceProvenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceType", "sourceLabel", "confidence"],
        "properties": {
          "sourceType": { "type": "string" },
          "sourceLabel": { "type": "string" },
          "sourceUrl": { "type": ["string", "null"], "format": "uri" },
          "confidence": { "type": "string", "enum": ["sample", "low", "medium", "high", "verified"] }
        }
      }
    },
    "confidence": { "type": "string", "enum": ["sample", "low", "medium", "high", "verified"] },
    "riskFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["prompt_injection", "spoofed_location", "unverified_audio", "relationship_accusation", "health_adjacent", "bystander_privacy", "coerced_access", "model_contamination"]
      },
      "uniqueItems": true
    },
    "userControls": {
      "type": "array",
      "items": { "type": "string", "enum": ["correct", "dispute", "delete", "archive", "exclude_from_model", "export", "request_review"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "lastReviewedAt"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "lastReviewedAt": { "type": "string", "format": "date-time" },
        "reviewNote": { "type": ["string", "null"] }
      }
    }
  }
}
