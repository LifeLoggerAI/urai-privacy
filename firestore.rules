rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function hasAdminClaim() {
      return signedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin')
      );
    }
    function isAdmin() { return hasAdminClaim(); }
    function deletionFenceIsInactive(uid) {
      // A present marker is inactive only when the server explicitly clears it.
      // Malformed markers and unreconciled planning leases must fail closed.
      let tombstone = /databases/$(database)/documents/privacyDeletionTombstones/$(uid);
      return !exists(tombstone) || (
        get(tombstone).data.get('active', null) == false
        && !get(tombstone).data.keys().hasAny([
          'deletionPlanningLeaseToken',
          'deletionPlanningLeaseUntil',
          'deletionPlanningLeaseRequestId',
          'deletionPlanningLeaseOperation',
          'deletionPlanningLeaseBy'
        ])
      );
    }
    function ownerProfileIdentityOnCreate(uid) {
      return (!('userId' in request.resource.data) || request.resource.data.userId == uid)
        && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == uid);
    }
    function ownerProfileIdentityOnUpdate(uid) {
      return (!('userId' in resource.data) || resource.data.userId == uid)
        && (!('ownerId' in resource.data) || resource.data.ownerId == uid)
        && ownerProfileIdentityOnCreate(uid);
    }
    function ownerIsNotChangingPrivilegedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'admin',
        'isAdmin',
        'legalHold',
        'markedForDeletion',
        'deletionMarkedAt',
        'entitlementTier',
        'founderOverride',
        'deleted',
        'accountStatus'
      ]);
    }
    function ownerIsNotCreatingPrivilegedFields() {
      return !request.resource.data.keys().hasAny([
        'role',
        'admin',
        'isAdmin',
        'legalHold',
        'markedForDeletion',
        'deletionMarkedAt',
        'entitlementTier',
        'founderOverride',
        'deleted',
        'accountStatus'
      ]);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && deletionFenceIsInactive(uid)
        && request.resource.data.uid == uid
        && ownerProfileIdentityOnCreate(uid)
        && ownerIsNotCreatingPrivilegedFields();
      allow update: if isAdmin() || (
        isOwner(uid)
        && deletionFenceIsInactive(uid)
        && request.resource.data.uid == uid
        && resource.data.uid == uid
        && ownerProfileIdentityOnUpdate(uid)
        && ownerIsNotChangingPrivilegedFields()
      );
      allow delete: if false;
    }

    match /privacyRequests/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /exportJobs/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /deletionRequests/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /consentRecords/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /consentEvents/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /consentRevocationOutbox/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update, delete: if false;

      match /acknowledgements/{consumerId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /retentionPolicies/{id} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /legalHoldRecords/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if isOwner(resource.data.targetUid) || isOwner(resource.data.actorUid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /adminActions/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /dataAccessEvents/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /policyVersions/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
