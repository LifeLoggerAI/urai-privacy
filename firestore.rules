rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Default Deny ---
    // Deny all access by default. Rules below grant specific permissions.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- User-Facing Collections ---

    // Users can read their own user record and update a limited set of non-critical fields.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'email']);
    }

    // Users have full control over their own consent profile.
    match /consent_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Users can create and read their own data export requests.
    // Status updates are blocked from the client to ensure server-side flow control.
    match /export_requests/{requestId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && request.resource.data.status == 'pending';
    }
    
    // Users can create and read their own account deletion requests.
    match /deletion_requests/{requestId} {
        allow read: if isOwner(resource.data.userId);
        allow create: if isOwner(request.resource.data.userId) && request.resource.data.status == 'pending';
    }
    
    // Users can read their own audit logs.
    match /audit_logs/{logId} {
      allow read: if isOwner(resource.data.userId);
    }

    // --- Server-Side Write, Client-Side Read (for user's own data) ---

    // For these collections, users can read their OWN data, but all mutations
    // MUST go through a secure server-side gateway.
    match /identity_vectors/{userId} {
      allow read: if isOwner(userId);
    }

    match /raw_signals/{docId} {
      allow read: if isOwner(resource.data.userId);
    }
    match /derived_signals/{docId} {
      allow read: if isOwner(resource.data.userId);
    }
    match /social_graph/{docId} {
      allow read: if isOwner(resource.data.userId);
    }
    match /shadow_signals/{docId} {
      allow read: if isOwner(resource.data.userId);
    }
    match /narrator_outputs/{docId} {
      allow read: if isOwner(resource.data.userId);
    }
    match /monetization_units/{docId} {
      allow read: if isOwner(resource.data.userId);
    }
    match /data_lineage/{docId} {
      allow read: if isOwner(resource.data.userId);
    }

    // --- Server-Only Collections ---

    // These collections contain sensitive operational, security, or anonymized data.
    // No client, not even the owner, should have direct read or write access.
    // Access is mediated entirely by trusted server-side functions.
    match /access_logs/{logId} {
      allow read, write: if false;
    }

    match /anonymized_data_pool/{docId} {
      allow read, write: if false;
    }

    match /monetization_sales/{docId} {
      allow read, write: if false;
    }

    match /policy_violations/{docId} {
      allow read, write: if false;
    }

    match /retention_jobs/{docId} {
      allow read, write: if false;
    }
  }
}
