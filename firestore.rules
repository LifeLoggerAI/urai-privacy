rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function hasAdminClaim() { return signedIn() && request.auth.token.admin == true; }
    function isRoleAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isAdmin() { return hasAdminClaim() || isRoleAdmin(); }
    function ownsNewDoc() { return signedIn() && request.resource.data.uid == request.auth.uid; }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if false;
    }

    match /privacyRequests/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if ownsNewDoc() && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /exportJobs/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if isAdmin();
      allow delete: if false;
    }

    match /deletionRequests/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if ownsNewDoc() && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /consentRecords/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update: if ownsNewDoc() || isAdmin();
      allow delete: if false;
    }

    match /consentEvents/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /retentionPolicies/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if isOwner(resource.data.targetUid) || isOwner(resource.data.actorUid) || isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /adminActions/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /dataAccessEvents/{id} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /policyVersions/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && (!exists(/databases/$(database)/documents/policyVersions/$(id)) || resource.data.status != 'published');
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}